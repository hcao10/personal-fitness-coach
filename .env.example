# 可选。完全使用 Cloudflare / 自托管模型时保持下列 OpenAI 项为空。
OPENAI_API_KEY=
# Model Hub：仅服务端持有健身专属应用 key；启用后教练不再自动回退到直连模型。
MODEL_HUB_API_KEY=
# 必须是该 App/任务获授权的模型别名；留空使用任务默认别名。
MODEL_HUB_COACH_MODEL=
# 仅本地运维脚本使用，不能装进业务 Worker：MODEL_HUB_ADMIN_KEY
# OPENAI_MODEL 必须填写 OpenAI 当前目录中的真实模型 ID（https://platform.openai.com/docs/models）。
# 留空则 OpenAI 路由不参与，AI 请求走 Cloudflare / 兼容端点。
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_AI_GATEWAY_TOKEN=
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_TEXT_MODEL=
AI_COMPAT_VISION_MODEL=
USDA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TAX_ENABLED=false
ADMOB_SSV_KEY_URL=
CMINE_ISSUER=https://identity.chwjh.com
CMINE_CLIENT_ID=
CMINE_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_EMAILS=admin@example.com
REWARD_AD_PROVIDER=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PROJECT_ID=
# RevenueCat webhook 不带签名，授予权益前必须用 REST API 回查订阅状态；
# 未配置 REVENUECAT_API_KEY 时 webhook 只记录事件、不发放任何权益。
REVENUECAT_API_KEY=
EXPO_ACCESS_TOKEN=
CMINE_MOBILE_CLIENT_IDS=
MAINTENANCE_SECRET=
APPLE_APP_TEAM_ID=
ANDROID_APP_SHA256_CERT_FINGERPRINT=
